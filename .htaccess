# ============================================================
# Pereira Oliveira Turismo — site estático (produção cPanel)
# ============================================================

# Home = index.php (22/10/2026): ele le o index.html e acrescenta a lista de
# proximas viagens do banco no painel "Sobre". Antes a ordem era invertida para
# proteger contra o index.php do WordPress antigo, que nao existe mais no
# servidor (conferido por FTP em 22/10/2026).
DirectoryIndex index.php index.html

# Página de erro personalizada
ErrorDocument 404 /404.html

# Força HTTPS
RewriteEngine On

# --- SEO fase 1: www -> nao-www (o site existia em 2 versoes pro Google) ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# URL limpa da pagina de links da bio do Instagram: /link -> /link.html
#
# /link/ COM barra tem que virar redirect de verdade, nao rewrite interno: o
# rewrite mantem a URL do documento como /link/, e ai todo caminho relativo da
# pagina (assets/css, assets/js, o logo) passa a resolver contra /link/ e da 404
# — a pagina abriria 200 e completamente pelada. O RewriteCond so vale para a
# regra imediatamente seguinte, por isso ele aparece duas vezes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^link/$ /link [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^link$ /link.html [L]


# --- SEO fase 1: URLs limpas dos roteiros (servidas por PHP) ---
RewriteRule ^roteiros/?$              /roteiros.php [L]
RewriteRule ^roteiros/([a-z0-9-]+)/?$ /roteiro.php?slug=$1 [L,QSA]
RewriteRule ^sitemap\.xml$           /sitemap.php [L]

# --- URLs sem .html (22/10/2026, pedido do cliente) ---
# 1) Quem chega pelo endereco antigo (.html) leva 301 para o limpo. A condicao
#    olha THE_REQUEST (o que o navegador pediu), e nao o caminho interno: assim
#    o rewrite de volta para o arquivo, logo abaixo, nunca vira loop.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?#] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(nossa-historia|contato|politica-de-privacidade|link)\.html[\s?#] [NC]
RewriteRule ^ /%1 [R=301,L]
# 2) Barra no fim vira redirect (rewrite com barra quebraria os caminhos
#    relativos da pagina: assets/... resolveria contra /contato/).
RewriteRule ^(nossa-historia|contato|politica-de-privacidade)/$ /$1 [R=301,L]
# 3) O endereco limpo serve a pagina. Nossa Historia passa pelo PHP, que
#    acrescenta as avaliacoes do Google e os videos do Instagram.
RewriteRule ^nossa-historia$ /nossa-historia.php [L]
RewriteRule ^contato$ /contato.html [L]
RewriteRule ^politica-de-privacidade$ /politica-de-privacidade.html [L]

# --- GEO (22/10/2026): FAQ e resumo para IA, servidos por PHP ---
RewriteRule ^perguntas-frequentes/?$ /faq.php [L]
RewriteRule ^llms\.txt$              /llms.php [L]

# --- SEO fase 1: 301 do site WordPress antigo (eram 404 sem redirect) ---
# destino proximo quando o roteiro existe; /roteiros quando o roteiro morreu
RedirectMatch 301 ^/turquia/?$               /roteiros/turquia
RedirectMatch 301 ^/japao-dubai-cingapura/?$ /roteiros/coreia-do-sul-japao-dubai
# versao antiga do mesmo roteiro (a capa no banco ainda e japaodoha-capa.jpg)
RedirectMatch 301 ^/japao-e-doha/?$          /roteiros/coreia-do-sul-japao-dubai
# Caminhos da India e Tesouros Asiaticos sairam do ar (ocultos, 404): apontar
# para o roteiro deixava o redirect terminando em 404. Vao para a lista.
RedirectMatch 301 ^/india-nepal/?$           /roteiros
RedirectMatch 301 ^/tesouros-asiaticos\.html$ /roteiros
# Roteiros do WordPress que o Search Console listou em 404 (22/10/2026)
RedirectMatch 301 ^/(grecia-terra-mar|mercados-de-natal-com-cruzeiro-pelo-rio-reno-e-concerto-de-andre|china-imperial|encantos-da-italia|corsega-joias-da-franca-e-italia|marrocos-lisboa|tunisia-e-malta|escandinavia|vietna-completo-e-singapura)/?$ /roteiros
# Restos tecnicos do WordPress: 410 (removido para sempre) tira do Google mais
# rapido que 404. Nada do site atual vive nesses caminhos.
RedirectMatch 410 ^/(feed|comments/feed)(/.*)?$
RedirectMatch 410 ^/(author|wp-includes|wp-content|wp-json|wp-admin)(/.*)?$
RedirectMatch 410 ^/(xmlrpc|wp-login)\.php$
RedirectMatch 301 ^/(nossos-roteiros|europa|africa|asia-oriente-medio|america-do-sul|oceania|america-do-norte-caribe|outros-destinos)/?$ /roteiros
RedirectMatch 301 ^/(marrocos|capitais-imperiais|cruzeiro-pelo-danubio|viagem-transiberiana|terra_santa-jordania|rota-romantica-alemanha|expresso-luzes-do-norte)/?$ /roteiros
RedirectMatch 301 ^/(grecia-terra-mar|mercados-de-natal|floracao-das-cerejeiras|encantos-do-mediterraneo)\.html$ /roteiros
RedirectMatch 301 ^/roteiro\.html$ /roteiros
# /nossa-historia e /contato agora SAO os enderecos (ver "URLs sem .html");
# o redirect deles para o .html saiu, senao seria loop.
RedirectMatch 301 ^/sobre-nos/?$ /nossa-historia
RedirectMatch 301 ^/(blog|dicas-de-viagem|6-dicas-para-uma-viagem-mais-proveitosa|meu-primeiro-post-do-blog)/?$ /
RedirectMatch 301 ^/(en|es)(/.*)?$ /

# Cache dos assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg   "access plus 1 year"
  ExpiresByType image/png    "access plus 1 year"
  ExpiresByType image/webp   "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css     "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  # PDF dos roteiros (/docs): nome tem hash, trocar o PDF muda a URL, cache seguro
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Protege o config local (segredos) caso caia na raiz
<FilesMatch "^config\.local\.php$">
  Require all denied
</FilesMatch>
